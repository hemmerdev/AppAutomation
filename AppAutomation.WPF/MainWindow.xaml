<Window x:Class="AppAutomation.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AppAutomation.WPF.Views"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" Grid.Column="0"
                  ItemsSource="{Binding AutomationRules}"
                  SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Header="Name" Width="*" />
                <DataGridTextColumn Binding="{Binding TriggerProcessName}" Header="Trigger process" Width="*" />
                <DataGridTextColumn Binding="{Binding TargetProcessName}" Header="Target process" Width="*" />
                <DataGridCheckBoxColumn Binding="{Binding IsEnabled}" Header="Enabled" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Grid.Column="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Add" Command="{Binding AddRuleCommand}"
                    MinWidth="72" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Edit" Command="{Binding EditRuleCommand}"
                    MinWidth="72" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="Delete" Command="{Binding DeleteRuleCommand}"
                    MinWidth="72" Padding="12,4" />
        </StackPanel>

        <views:AddRuleView Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                           Width="320"
                           Margin="16,0,0,0"
                           VerticalAlignment="Top"
                           Visibility="{Binding IsRuleFormOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</Window>